.head {
  background-color: #f0f0f0;
  padding: 200rpx 30rpx 0 30rpx;
}
.head .headuser {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.head .headuser .headuserleft {
  display: flex;
  align-items: center;
  gap: 30rpx;
}
.head .headuser .headuserleft image {
  height: 100rpx;
  width: 100rpx;
  border-radius: 50rpx;
}
.head .headuser .headuserleft .headuserleftinfo {
  display: flex;
  gap: 24rpx;
  flex-direction: column;
}
.head .headuser .headuserleft .headuserleftinfo .headuserleftinfotop {
  display: flex;
  gap: 20rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 40rpx;
  color: #54585F;
  line-height: 28rpx;
}
.head .headuser .headuserleft .headuserleftinfo .headuserleftinfobottom {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #54585F;
  opacity: 0.8;
}
.head .headuser .headuserright {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  border: 4px solid rgba(139, 146, 158, 0.4);
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 22rpx;
  color: #54585F;
  opacity: 0.8;
}
.head .headrecord {
  display: flex;
  justify-content: space-around;
  margin-top: 39rpx;
}
.head .headrecord .headrecorditem {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  gap: 20rpx;
}
.head .headrecord .headrecorditem .headrecorditemnum {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 30rpx;
  color: #54585F;
}
.head .headrecord .headrecorditem .headrecorditeminfo {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #92969E;
}
.head .headvip {
  margin-top: 35rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #38464C 0%, #646774 100%);
  border-radius: 19rpx 19rpx 0rpx 0rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 18rpx;
}
.head .headvip .headvipleft {
  display: flex;
  align-items: center;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #FFFFFF;
  line-height: 28rpx;
}
.head .headvip .headvipleft image {
  width: 40rpx;
  height: 40rpx;
}
.head .headvip .headvipleft .headviplefttitle {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #FAD3B9;
  line-height: 28rpx;
  font-style: italic;
  margin: 0 24rpx 0 10rpx;
}
.ServiceCenter {
  padding: 60rpx 30rpx;
  border-radius: 20rpx 20rpx 0rpx 0rpx;
}
.ServiceCenter .ServiceCentertitle {
  display: flex;
  justify-content: space-between;
}
.ServiceCenter .ServiceCentertitle .ServiceCentertitleleft {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #54585F;
  line-height: 28rpx;
}
.ServiceCenter .ServiceCentertitle .ServiceCentertitleright {
  margin-right: 20rpx;
  display: flex;
  gap: 10rpx;
  align-items: center;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #9BA2AF;
  line-height: 28rpx;
}
.ServiceCenter .ServiceCenteritems {
  display: flex;
  justify-content: space-between;
  margin: 60rpx 20rpx;
}
.ServiceCenter .ServiceCenteritems .ServiceCenteritemsitem {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 28rpx;
  color: #54585F;
  line-height: 28rpx;
}
.ServiceCenter .ServiceCenteritems .ServiceCenteritemsitem image {
  width: 50rpx;
  height: 50rpx;
}
.ServiceCenter .ServiceCenterpromotion {
  width: 100%;
  height: 200rpx;
}
.CommonServices {
  padding: 0 30rpx;
}
.CommonServices .CommonServicestitle {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #54585F;
  line-height: 28rpx;
}