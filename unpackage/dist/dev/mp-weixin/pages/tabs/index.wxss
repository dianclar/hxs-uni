page {
  background-color: #F2F4F6;
  padding-bottom: 300rpx;
}
.head {
  position: relative;
  height: 538rpx;
  background: #0D7CFF;
}
.head .title {
  width: 238rpx;
  height: 33rpx;
  position: absolute;
  top: 115rpx;
  left: 32rpx;
}
.head .search {
  width: 690rpx;
  height: 72rpx;
  background: #C7E1FF;
  border-radius: 20rpx;
  position: absolute;
  top: 186rpx;
  left: 30rpx;
}
.head .search .icon {
  width: 36rpx;
  height: 36rpx;
  position: absolute;
  top: 18rpx;
  left: 27rpx;
}
.head .search .split {
  width: 2rpx;
  height: 24rpx;
  background: #789CC6;
  border-radius: 1rpx;
  position: absolute;
  top: 24rpx;
  left: 88rpx;
}
.head .search text {
  width: 201rpx;
  height: 26rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #789CC6;
  line-height: 28rpx;
  position: absolute;
  top: 23rpx;
  left: 117rpx;
}
.head .publicity {
  width: 690rpx;
  height: 230rpx;
  position: absolute;
  top: 280rpx;
  left: 30rpx;
}
.head .publicity .img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  /* 关键属性：保持比例填充容器 */
  object-position: center;
  /* 图片居中 */
}
.head .bottom {
  position: absolute;
  bottom: 0;
  filter: drop-shadow(0 -1rpx 16rpx rgba(15, 79, 154, 0.3));
}
.head .bottom .bot {
  width: 750rpx;
  height: 80rpx;
  background-color: #FFFFFF;
  -webkit-clip-path: polygon(0% 0%, 0% 100%, 100% 100%, 100% 0%, 90% 20%, 80% 39%, 65% 50%, 50% 60%, 35% 50%, 20% 39%, 10% 20%);
          clip-path: polygon(0% 0%, 0% 100%, 100% 100%, 100% 0%, 90% 20%, 80% 39%, 65% 50%, 50% 60%, 35% 50%, 20% 39%, 10% 20%);
}
.community {
  width: 750rpx;
  background: #FFFFFF;
  position: relative;
  margin-top: -4rpx;
  padding-bottom: 26rpx;
}
.community .navigator {
  width: 100%;
  background: #FFFFFF;
  display: flex;
  justify-content: space-evenly;
}
.community .navigator image {
  width: 92rpx;
  height: 92rpx;
}
.community .navigator text {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #333333;
  line-height: 28rpx;
}
.community .title {
  margin-top: 44rpx;
  margin-left: 30rpx;
  margin-bottom: 28rpx;
  width: 132rpx;
  height: 30rpx;
}
.community .com {
  top: 225rpx;
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-evenly;
  gap: 22rpx 0;
}
.community .com image {
  width: 334rpx;
  height: 180rpx;
}
.event {
  background: #FFFFFF;
  margin-top: 22rpx;
  padding: 30rpx;
}
.event .eventtitle {
  display: flex;
  justify-content: space-between;
}
.event .eventtitle .titleimg {
  width: 134rpx;
  height: 32rpx;
}
.event .eventtitle .eventtitleleft {
  display: flex;
  gap: 18rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #9BA2AF;
  line-height: 28rpx;
}
.event .eventtitle .eventtitleleft image {
  width: 12rpx;
  height: 22rpx;
}
.event .eventinfo {
  display: flex;
  gap: 27rpx;
  align-items: center;
  margin-top: 24rpx;
}
.event .eventinfo image {
  width: 240rpx;
  height: 160rpx;
}
.event .eventinfo .eventinfoleft {
  flex: 1;
  width: 0;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #AFAFAF;
  line-height: 42rpx;
}
.event .eventinfo .eventinfoleft .eventinfolefttitle {
  margin-bottom: 20rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 30rpx;
  color: #111111;
  line-height: 42rpx;
  display: -webkit-box;
  /* 设置为WebKit内核的弹性盒子模型 */
  -webkit-box-orient: vertical;
  /* 垂直排列 */
  -webkit-line-clamp: 2;
  /* 限制显示行 */
  overflow: hidden;
  /* 隐藏超出范围的内容 */
  text-overflow: ellipsis;
  /* 使用省略号 */
  /* 溢出时显示省略号 */
}
.event .hr {
  margin-top: 24rpx;
  height: 2rpx;
  background: #EEEEEE;
}
.clock {
  width: 750rpx;
  height: 188rpx;
  background: #FFFFFF;
  box-shadow: 0rpx -1rpx 8rpx 0rpx rgba(169, 169, 169, 0.3);
  border-radius: 60rpx 60rpx 0rpx 0rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: fixed;
  bottom: 0;
  z-index: 1;
}
.clock .buttom {
  width: 670rpx;
  height: 108rpx;
  background: linear-gradient(90deg, #6EB1FF 0%, #0D7CFF 100%);
  box-shadow: 0rpx 10rpx 20rpx 0rpx rgba(13, 124, 255, 0.35);
  border-radius: 54rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  align-items: center;
}
.clock .buttom .title {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 28rpx;
}
.clock .buttom .info {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 22rpx;
  color: #FFFFFF;
  line-height: 28rpx;
}
.clockin {
  position: fixed;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0rpx 0rpx;
  width: 100%;
}
.clockin .clockintitle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #111111;
  line-height: 28rpx;
  border-bottom: 2rpx solid #efefef;
}
.clockin .clockininfo {
  margin: 39rpx;
}
.clockin .clockininfo .clockininfotitle {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 30rpx;
  color: #111111;
  line-height: 34rpx;
}
.clockin .clockininfo .clockininfotext {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #92969E;
  line-height: 42rpx;
  margin-top: 27rpx;
}
.clockin .clockinbottom {
  margin: 32rpx 39rpx;
  display: flex;
  gap: 30rpx;
}
.clockin .clockinbottom .clockinbottombutton {
  height: 210rpx;
  width: 100%;
  background: #F1F2F5;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 22rpx;
}
.clockin .clockinbottom .clockinbottombutton image {
  width: 80rpx;
  height: 80rpx;
}