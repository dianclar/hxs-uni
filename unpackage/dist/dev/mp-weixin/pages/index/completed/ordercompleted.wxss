.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
image {
  height: 314rpx;
  width: 314rpx;
  margin-bottom: 30rpx;
}
.title {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 36rpx;
  color: #1A1A1A;
  line-height: 24rpx;
}
.info {
  width: 434rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #5A5A5A;
  line-height: 44rpx;
  margin: 60rpx;
  text-align: center;
}
.button {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}
.button .order {
  width: 450rpx;
  height: 90rpx;
  background: linear-gradient(0deg, #0D7CFF 0%, #3F97FF 100%);
  border-radius: 45rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 24rpx;
}
.button .mall {
  width: 450rpx;
  height: 90rpx;
  background: rgba(13, 124, 255, 0.1);
  border-radius: 45rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #0D7CFF;
  line-height: 24rpx;
}