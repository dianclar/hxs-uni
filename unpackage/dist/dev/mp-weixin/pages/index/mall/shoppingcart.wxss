page {
  background-color: #F2F4F6;
}
.menubar {
  height: 88rpx;
  background: #FFFFFF;
  padding: 0 30rpx;
  display: flex;
  justify-content: space-between;
}
.menubar .menubarleft {
  display: flex;
  gap: 15rpx;
  align-items: center;
}
.menubar .menubarright {
  display: flex;
  gap: 39rpx;
  align-items: center;
}
.menubar .menubarright .menubarrighticon {
  width: 2rpx;
  height: 40rpx;
  background: #D1D1D1;
}
.input {
  padding: 0 30rpx;
  background: #F1F1F1;
  margin: 0 15rpx;
}
.shppingcartinfo {
  background: #FFFFFF;
  padding: 30rpx;
  margin-top: 20rpx;
}
.shppingcartinfo .shppingcartinfoitem {
  display: flex;
  align-items: center;
  gap: 25rpx;
}
.shppingcartinfo .shppingcartinfoitem .shppingcartinfoitemleft {
  display: flex;
  gap: 30rpx;
  align-items: center;
}
.shppingcartinfo .shppingcartinfoitem .shppingcartinfoitemleft .shppingcartinfoitemlefticon {
  width: 39rpx;
  height: 39rpx;
  box-shadow: 0rpx 5rpx 10rpx 0rpx rgba(139, 139, 139, 0.5);
  border-radius: 50%;
  border: 3px solid #8B8B8B;
}
.shppingcartinfo .shppingcartinfoitem .shppingcartinfoitemleft image {
  width: 182rpx;
  height: 182rpx;
  background: #E0E0E0;
  border-radius: 10rpx;
}
.shppingcartinfo .shppingcartinfoitem .shppingcartinfoitemright {
  height: 200rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.shppingcartinfo .shppingcartinfoitem .shppingcartinfoitemright picker view {
  width: -webkit-fit-content;
  width: fit-content;
  background: #F2F2F2;
  border-radius: 6rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 20rpx;
  color: #848791;
  display: flex;
  padding: 8rpx 12rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.shppingcartinfo .shppingcartinfoitem .shppingcartinfoitemright .shppingcartinfoitemrighttitle {
  overflow: hidden;
  text-overflow: ellipsis;
  width: 409rpx;
  height: 80rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 28rpx;
  color: #333333;
  line-height: 40rpx;
}
.shppingcartinfo .shppingcartinfoitem .shppingcartinfoitemright .shppingcartinfoitemrightbottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.shppingcartinfo .shppingcartinfoitem .shppingcartinfoitemright .shppingcartinfoitemrightbottom .shppingcartinfoitemrightbottomleft {
  display: flex;
  align-items: flex-end;
}
.shppingcartinfo .shppingcartinfoitem .shppingcartinfoitemright .shppingcartinfoitemrightbottom .shppingcartinfoitemrightbottomleft .shppingcartinfoitemrightbottomlefttitle {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #D02835;
  line-height: 28rpx;
}
.shppingcartinfo .shppingcartinfoitem .shppingcartinfoitemright .shppingcartinfoitemrightbottom .shppingcartinfoitemrightbottomleft .shppingcartinfoitemrightbottomleftSubtitle {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 24rpx;
  color: #D02835;
  line-height: 28rpx;
  margin-left: 5rpx;
  position: relative;
  top: 2rpx;
  left: 1rpx;
}
.shppingcartinfo .shppingcartinfoitem .shppingcartinfoitemright .shppingcartinfoitemrightbottom .shppingcartinfoitemrightbottomleft .shppingcartinfoitemrightbottomleftinfo {
  margin-left: 10rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 20rpx;
  color: #848791;
  position: relative;
  top: 5rpx;
}
.shppingcartinfo .hr {
  width: 618rpx;
  height: 2rpx;
  background: #EFEFEF;
  margin: 30rpx 0;
  margin-left: 70rpx;
}
.bottom {
  width: -webkit-fill-available;
  height: 120rpx;
  background: #FFFFFF;
  box-shadow: 0rpx -1rpx 8rpx 0rpx rgba(169, 169, 169, 0.3);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 70rpx 39rpx;
  position: fixed;
  bottom: 0;
  z-index: 1000;
}
.bottom .bottomleft {
  display: flex;
  align-items: center;
  gap: 15rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #111111;
  line-height: 28rpx;
}
.bottom .bottomleft view {
  width: 39rpx;
  height: 39rpx;
  box-shadow: 0rpx 5rpx 10rpx 0rpx rgba(139, 139, 139, 0.5);
  border-radius: 50%;
  border: 3px solid #8B8B8B;
}
.bottom .bottomright {
  display: flex;
  align-items: center;
  gap: 50rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #111111;
  line-height: 28rpx;
}
.bottom .bottomright view {
  width: 210rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #308FFF 0%, #0D7CFF 100%);
  box-shadow: 0rpx 0rpx 10rpx 0rpx rgba(13, 124, 255, 0.5);
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 28rpx;
}