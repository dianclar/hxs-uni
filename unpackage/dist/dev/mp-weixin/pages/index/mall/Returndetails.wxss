page {
  background: #f0f0f0;
  padding-bottom: 200rpx;
}
.goodsstatus {
  margin: 20rpx 30rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}
.goodsstatus .goodsstatustop {
  display: flex;
  align-items: center;
  gap: 15rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #333333;
}
.goodsstatus .goodsstatushr {
  height: 2rpx;
  border: 1px solid #EEEEEE;
  margin: 30rpx 0;
}
.goodsstatus .goodsstatusitem {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
  font-family: PingFang SC;
  font-weight: 400;
  font-size: 24rpx;
  color: #848791;
  line-height: 28rpx;
}
.goodsstatus .goodsstatusitem .icon {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 2px solid #848791;
  flex-shrink: 0;
}
.goodsinfo {
  padding: 30rpx;
  margin: 20rpx 30rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}
.goodsinfo .goodsinfotitle {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 30rpx;
  color: #111111;
  line-height: 28rpx;
}
.goodsinfo .goodsinfogoods {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.goodsinfo .goodsinfogoods image {
  width: 180rpx;
  height: 180rpx;
}
.goodsinfo .goodsinfogoods .goodsinfogoodsright {
  width: auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
}
.goodsinfo .goodsinfogoods .goodsinfogoodsright .goodsinfogoodsrighttitle {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 28rpx;
  color: #333333;
  line-height: 40rpx;
}
.goodsinfo .goodsinfogoods .goodsinfogoodsright .goodsinfogoodsrightsubtitle {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #848791;
}
.goodsinfo .goodsinfogoods .goodsinfogoodsright .goodsinfogoodsrightprice {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.goodsinfo .goodsinfogoods .goodsinfogoodsright .goodsinfogoodsrightprice .goodsinfogoodsrightpriceleft {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #D02835;
  line-height: 28rpx;
}
.goodsinfo .goodsinfogoods .goodsinfogoodsright .goodsinfogoodsrightprice .goodsinfogoodsrightpriceright {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #848791;
}
.goodsinfo .goodsinfogoods .goodsinfogoodsright .goodsinfogoodsrighttag {
  border-radius: 6rpx;
  border: 2px solid #D02835;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 18rpx;
  color: #D02835;
  padding: 2rpx 5rpx;
  width: -webkit-fit-content;
  width: fit-content;
}
.goodsinfo .goodsinfohr {
  margin: 30rpx 0;
  height: 2rpx;
  border: 1px solid #EEEEEE;
}
.goodsinfo .goodsinfodata {
  display: flex;
  justify-content: space-between;
  gap: 50rpx;
  margin-top: 40rpx;
}
.goodsinfo .goodsinfodata .goodsinfodatatitle {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #848791;
  flex-shrink: 0;
}
.goodsinfo .goodsinfodata .goodsinfodataright {
  flex: 1;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #333333;
  line-height: 40rpx;
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
  align-items: center;
  text-align: right;
}
.goodsinfo .goodsinfodata .goodsinfodataright image {
  width: 142rpx;
  height: 142rpx;
  background: #E4F0FF;
  border-radius: 10rpx;
  margin-left: 8rpx;
}
.goodsinfo .goodsinfodata .reason {
  text-align: left;
}
.goodsinfo .goodsinfodata .price {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 28rpx;
  color: #D02835;
}
.bottom {
  position: fixed;
  bottom: 0;
  display: flex;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
  box-shadow: 0rpx -1rpx 8rpx 0rpx rgba(169, 169, 169, 0.3);
  width: -webkit-fill-available;
  padding-bottom: 90rpx;
}
.bottom .bottomright {
  display: flex;
  gap: 18rpx;
}
.aftersalesservice {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 39rpx 0;
  width: 630rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
}
.aftersalesservice .aftersalesservicetitle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 30rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 32rpx;
  color: #111111;
  line-height: 28rpx;
}
.aftersalesservice .aftersalesservicehr {
  height: 2rpx;
  background: #EFEFEF;
  border-radius: 1rpx;
  margin: 39rpx 0;
}
.aftersalesservice .aftersalesserviceinfo {
  background: #F4F6F8;
  border-radius: 16rpx;
  padding: 35rpx 30rpx;
  margin: 0 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
}
.aftersalesservice .aftersalesserviceinfo .aftersalesserviceinfoleft {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 30rpx;
}
.aftersalesservice .aftersalesserviceinfo .aftersalesserviceinfoleft image {
  width: 44rpx;
  height: 44rpx;
}
.aftersalesservice .aftersalesserviceinfo .aftersalesserviceinfoleft .aftersalesserviceinfoleftright .aftersalesserviceinfoleftrighttop {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #111111;
  line-height: 34rpx;
}
.aftersalesservice .aftersalesserviceinfo .aftersalesserviceinfoleft .aftersalesserviceinfoleftright .aftersalesserviceinfoleftrightbottom {
  margin-top: 15rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #92969E;
  line-height: 34rpx;
}