page {
  background: #f0f0f0;
}
.goodsinfo {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 20rpx 30rpx;
  padding: 30rpx;
}
.goodsinfo image {
  width: 180rpx;
  height: 180rpx;
  background: #E0E0E0;
  border-radius: 10rpx;
  flex-shrink: 0;
}
.goodsinfo .goodsinforight {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  flex: 1;
  width: 0;
}
.goodsinfo .goodsinforight .goodsinforighttitlt {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 28rpx;
  color: #333333;
  line-height: 40rpx;
}
.goodsinfo .goodsinforight .goodsinforightsubtitle {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #848791;
}
.goodsinfo .goodsinforight .goodsinforightprice {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.goodsinfo .goodsinforight .goodsinforightprice .goodsinforightpriceleft {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #D02835;
  line-height: 28rpx;
}
.goodsinfo .goodsinforight .goodsinforightprice .goodsinforightpriceright {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #848791;
}
.goodsinfo .goodsinforight .goodsinforightguarantee {
  border-radius: 6rpx;
  border: 2px solid #D02835;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 18rpx;
  color: #D02835;
  padding: 5rpx 10rpx;
  width: -webkit-fit-content;
  width: fit-content;
}
.form {
  margin: 20rpx 30rpx;
  padding: 1rpx 30rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}
.form .formitem {
  display: flex;
  gap: 15rpx;
  justify-content: space-between;
  align-items: center;
  margin: 39rpx 0;
}
.form .formitem .formitemleft {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #111111;
  line-height: 28rpx;
}
.form .formitem .formitemchoice {
  display: flex;
  gap: 15rpx;
  align-items: center;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #848791;
  line-height: 28rpx;
}
.form .formitem .formiteminput {
  flex: 1;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #848791;
  line-height: 28rpx;
}
.form .formitem .price {
  color: #d02835;
}
.upimg {
  margin: 20rpx 30rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}
.upimg .upimgtitle {
  margin-bottom: 30rpx;
}
.upimg .upimgdata {
  width: 142rpx;
  height: 142rpx;
  background: #FFFFFF;
  border-radius: 10rpx;
  border: 2px dashed #949393;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bottom {
  position: fixed;
  bottom: 0;
  background: #FFFFFF;
  box-shadow: 0rpx -1rpx 8rpx 0rpx rgba(169, 169, 169, 0.3);
  width: 100%;
}
.bottom .bottombutton {
  height: 80rpx;
  margin: 20rpx 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #0D7CFF;
  border-radius: 16rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 28rpx;
}
.aftersalesservice {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 30rpx 0;
  width: 630rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
}
.aftersalesservice .aftersalesservicetitle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 30rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 32rpx;
  color: #111111;
  line-height: 28rpx;
}
.aftersalesservice .aftersalesservicehr {
  height: 2rpx;
  background: #EFEFEF;
  border-radius: 1rpx;
  margin: 30rpx 0;
}
.aftersalesservice .aftersalesserviceinfo {
  background: #F4F6F8;
  border-radius: 16rpx;
  padding: 35rpx 30rpx;
  margin: 0 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #92969E;
  line-height: 28rpx;
}
.aftersalesservice .aftersalesserviceinfo .aftersalesserviceinfoaction {
  font-weight: bold;
  color: #0D7CFF;
}
.aftersalesservice .aftersalesservicebutton {
  height: 80rpx;
  margin: 0 30rpx;
  background: #0D7CFF;
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 28rpx;
}