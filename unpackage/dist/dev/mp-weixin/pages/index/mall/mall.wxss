page {
  background-color: #F2F4F6;
}
.icon {
  position: absolute;
  top: 115rpx;
  left: 30rpx;
}
.head {
  height: 300rpx;
  background: url(data:image/png;base64,) repeat fixed center;
  overflow: hidden;
}
.head text {
  position: absolute;
  top: 115rpx;
  left: 340rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 36rpx;
  color: #FFFFFF;
  line-height: 28rpx;
}
.head .search {
  width: 690rpx;
  height: 72rpx;
  background: #C7E1FF;
  border-radius: 20rpx;
  position: absolute;
  top: 200rpx;
  left: 30rpx;
}
.head .search .icon {
  width: 36rpx;
  height: 36rpx;
  position: absolute;
  top: 18rpx;
  left: 27rpx;
}
.head .search .split {
  width: 2rpx;
  height: 24rpx;
  background: #789CC6;
  border-radius: 1rpx;
  position: absolute;
  top: 24rpx;
  left: 88rpx;
}
.head .search text {
  width: 201rpx;
  height: 26rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #789CC6;
  line-height: 28rpx;
  position: absolute;
  top: 23rpx;
  left: 117rpx;
}
.publicity {
  margin: 20rpx 30rpx;
  height: 200rpx;
  width: 690rpx;
}
.navigator {
  height: 100rpx;
  margin-left: 30rpx;
  display: flex;
  gap: 0 80rpx;
}
.navigator .navyes {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.navigator .navyes text {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 30rpx;
  color: #0D7CFF;
}
.navigator .navyes image {
  height: 15rpx;
  width: 40rpx;
}
.navigator .navno {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.navigator .navno text {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #848791;
}
.navigator .navno image {
  height: 15rpx;
  width: 40rpx;
  display: none;
}
.malls {
  width: 690rpx;
  height: 244rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 20rpx 30rpx;
  display: flex;
}
.malls image {
  width: 244rpx;
  height: 244rpx;
  background: #CFCFD7;
  border-radius: 20rpx;
}
.malls .right {
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  padding-left: 20rpx;
}
.malls .right .title {
  width: 409rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 28rpx;
  color: #333333;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  white-space: normal;
  overflow: hidden;
}
.malls .right .tabs {
  display: flex;
  gap: 0 6rpx;
}
.malls .right .tabs .tab {
  background: #FFFFFF;
  border-radius: 4rpx;
  border: 1px solid rgba(208, 40, 53, 0.2);
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 18rpx;
  color: #D02835;
}
.malls .right .price .pricepro {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #D02835;
  line-height: 28rpx;
}
.malls .right .price .pro {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 22rpx;
  color: #D02835;
  line-height: 28rpx;
  margin-left: 8rpx;
  margin-right: 16rpx;
}
.malls .right .price .info {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 22rpx;
  color: #848791;
}
.malls .right .info text {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #848791;
  margin-right: 16rpx;
}