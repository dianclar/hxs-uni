.bottom {
  width: 750rpx;
  height: 108rpx;
  background: #FFFFFF;
  box-shadow: 0rpx -1rpx 8rpx 0rpx rgba(169, 169, 169, 0.3);
  display: flex;
  justify-content: space-evenly;
  align-items: center;
  position: fixed;
  bottom: 0;
  padding-bottom: 39rpx;
  z-index: 1;
}
.bottom .bottomicon {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 20rpx;
  color: #333333;
  line-height: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.bottom .bottomicon .bottomiconbadge {
  border: 1px solid #EC1806;
  border-radius: 39rpx;
  position: absolute;
  right: 0;
  top: -10rpx;
  background: #fff;
  z-index: 10;
}
.bottom .bottombutton {
  display: flex;
}
.bottom .bottombutton .shopcat {
  width: 150rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #F7BC13 0%, #FFCB19 100%);
  border-radius: 10rpx 0rpx 0rpx 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.bottom .bottombutton .shop {
  width: 380rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #D02835 0%, #D33B0B 100%);
  border-radius: 0rpx 10rpx 10rpx 0rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 28rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 30rpx;
}
.tags .tagnoaction {
  background: #E6F2FF;
  border-radius: 10rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #111111;
  line-height: 42rpx;
  padding: 10rpx 25rpx;
}
.tags .tagaction {
  border: 2px solid #0D7CFF;
  color: #0D7CFF;
  display: flex;
  gap: 10rpx;
}
.evaluation {
  padding: 0 30rpx;
}
.evaluation .evaluationinfo {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}
.evaluation .evaluationinfo .evaluationinfouser {
  display: flex;
  justify-content: space-between;
}
.evaluation .evaluationinfo .evaluationinfouser .evaluationinfouserleft {
  display: flex;
  gap: 18rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #111111;
  line-height: 28rpx;
  align-items: center;
}
.evaluation .evaluationinfo .evaluationinfouser .evaluationinfouserleft image {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #848791;
}
.evaluation .evaluationinfo .evaluationinfouser .evaluationinfouserright {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #848791;
  line-height: 28rpx;
}
.evaluation .evaluationinfo .evaluationinfoevaluation {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #000000;
  line-height: 40rpx;
}
.evaluation .evaluationinfo .evaluationinfoimg {
  display: flex;
  gap: 20rpx;
}
.evaluation .evaluationinfo .evaluationinfoimg image {
  width: 158rpx;
  height: 158rpx;
  background: #D5E8FF;
  border-radius: 10rpx;
}
.evaluation .evaluationinfo .evaluationinfodetails {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #848791;
}
.evaluation .hr {
  width: 690rpx;
  height: 2rpx;
  background: #EFEFEF;
  margin: 35rpx 0;
}
.specification .specificationimg {
  display: flex;
  align-items: flex-end;
  gap: 25rpx;
  margin-bottom: 40rpx;
}
.specification .specificationimg image {
  width: 182rpx;
  height: 182rpx;
  background: #E0E0E0;
  border-radius: 10rpx;
}
.specification .specificationimg text {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 44rpx;
  color: #D02835;
  line-height: 28rpx;
}
.specification text {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 30rpx;
  color: #111111;
  line-height: 40rpx;
}
.specification .specificationinfo {
  margin: 30rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.specification .specificationinfo view {
  background: #FFFFFF;
  border-radius: 16rpx 16rpx 0rpx 0rpx;
  font-family: PingFang SC;
  font-weight: 400;
  font-size: 28rpx;
  color: #848791;
  padding: 15rpx 30rpx;
  width: -webkit-fit-content;
  width: fit-content;
}
.specification .specificationinfo .action {
  background: rgba(208, 40, 53, 0.1);
  border-radius: 10rpx;
  border: 2px solid #D02835;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 28rpx;
  color: #D02835;
}
.specification .specificationinfo .action text {
  color: #D02835;
}
.specification .hr {
  width: 690rpx;
  height: 2rpx;
  background: #EFEFEF;
}
.specification .specificationnum {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.specification .specificationnum .input {
  padding: 10rpx 30rpx;
  background: #F1F1F1;
}
.specification .specificationbottom {
  display: flex;
  position: fixed;
  bottom: 100rpx;
}
.specification .specificationbottom .shopcat {
  width: 150rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #F7BC13 0%, #FFCB19 100%);
  border-radius: 10rpx 0rpx 0rpx 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.specification .specificationbottom .shop {
  width: 540rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #D02835 0%, #D33B0B 100%);
  border-radius: 0rpx 10rpx 10rpx 0rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 28rpx;
}
.addshopcat {
  width: -webkit-fit-content;
  width: fit-content;
  background: #000000;
  border-radius: 50rpx;
  opacity: 0.7;
  padding: 35rpx 60rpx;
  gap: 30rpx;
  display: flex;
  align-items: center;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #FFFFFF;
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 39;
}