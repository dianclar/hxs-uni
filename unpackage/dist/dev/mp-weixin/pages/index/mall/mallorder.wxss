.nomall {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  gap: 180rpx;
}
.nomall .nomallimg {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  gap: 10rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #888888;
  line-height: 42rpx;
}
.nomall .nomallimg image {
  width: 320rpx;
  height: 320rpx;
}
.nomall .nomallbutton {
  width: 450rpx;
  height: 90rpx;
  background: rgba(13, 124, 255, 0.1);
  border-radius: 45rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #0D7CFF;
  line-height: 24rpx;
}
.mallorder {
  background-color: #f0f0f0;
  padding: 0 30rpx;
}
.mallorder .OrderType {
  padding: 20rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15rpx;
}
.mallorder .OrderType view {
  width: 114rpx;
  height: 66rpx;
  background: #FFFFFF;
  border-radius: 33rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #888888;
  line-height: 28rpx;
}
.mallorder .OrderType .OrderTypeaction {
  background: #0D7CFF;
  color: #FFFFFF;
  font-weight: bold;
}
.mallorder .OrderType .OrderTypehr {
  width: 2rpx;
  height: 32rpx;
  background: #000000;
  opacity: 0.2;
}
.mallorder .OrderType .OrderTyperefund {
  width: 160rpx;
}
.mallorder .orderitems {
  padding: 24rpx 30rpx;
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.mallorder .orderitems .orderitemstitle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}
.mallorder .orderitems .orderitemstitle .orderitemstitleleft {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #111111;
  line-height: 28rpx;
}
.mallorder .orderitems .orderitemstitle .orderitemstitleleft image {
  width: 36rpx;
  height: 36rpx;
}
.mallorder .orderitems .orderitemstitle .orderitemstitleright {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 28rpx;
  color: #0D7CFF;
  line-height: 30rpx;
}
.mallorder .orderitems .orderitemstitle .orderitemstitleright .orderitemstitlerighticon {
  width: 10rpx;
  height: 10rpx;
  background: #0D7CFF;
  border-radius: 50%;
}
.mallorder .orderitems .orderitemsinfo {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.mallorder .orderitems .orderitemsinfo image {
  width: 180rpx;
  height: 180rpx;
}
.mallorder .orderitems .orderitemsinfo .orderitemsinforight {
  width: auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
}
.mallorder .orderitems .orderitemsinfo .orderitemsinforight .orderitemsinforighttitle {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 28rpx;
  color: #333333;
  line-height: 40rpx;
}
.mallorder .orderitems .orderitemsinfo .orderitemsinforight .orderitemsinforightsubtitle {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #848791;
}
.mallorder .orderitems .orderitemsinfo .orderitemsinforight .orderitemsinforightprice {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.mallorder .orderitems .orderitemsinfo .orderitemsinforight .orderitemsinforightprice .orderitemsinforightpriceleft {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #D02835;
  line-height: 28rpx;
}
.mallorder .orderitems .orderitemsinfo .orderitemsinforight .orderitemsinforightprice .orderitemsinforightpriceright {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #848791;
}
.mallorder .orderitems .orderitemsinfo .orderitemsinforight .orderitemsinforighttag {
  border-radius: 6rpx;
  border: 2px solid #D02835;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 18rpx;
  color: #D02835;
  padding: 2rpx 5rpx;
  width: -webkit-fit-content;
  width: fit-content;
}
.mallorder .orderitems .orderitemshr {
  height: 2rpx;
  border: 1px solid #EEEEEE;
  margin: 24rpx 0;
}
.mallorder .orderitems .orderitemsoption {
  display: flex;
  justify-content: space-between;
}
.mallorder .orderitems .orderitemsoption .orderitemsoptionright {
  display: flex;
  gap: 18rpx;
}
.mallorder .orderitems .orderitemsoption .orderitemsoptionright view {
  width: 132rpx;
  height: 52rpx;
  border-radius: 10rpx;
  border: 2px solid #C9C9C9;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #333333;
  line-height: 40rpx;
}
.mallorder .orderitems .orderitemsoption .orderitemsoptionright .orderitemsoptionrightprimary {
  border: 2px solid #0D7CFF;
  color: #0D7CFF;
}