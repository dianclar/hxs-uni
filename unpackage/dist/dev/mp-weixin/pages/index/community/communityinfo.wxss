.head .headimg {
  position: absolute;
  width: 100%;
  height: 480rpx;
  z-index: -1;
}
.head .headtitle {
  margin: 30rpx;
  margin-top: 0;
  font-family: DingTalk JinBuTi;
  font-weight: 400;
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 34rpx;
}
.head .headinfo {
  display: flex;
  gap: 22rpx;
  padding: 0 30rpx;
  align-items: center;
}
.head .headinfo image {
  width: 172rpx;
  height: 120rpx;
}
.head .headinfo .headinforight {
  flex: 1;
  width: 0;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #FFFFFF;
  line-height: 44rpx;
}
.head .headinfo .headinforight .headinforighttitle {
  font-weight: bold;
  font-size: 32rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}
.head .headshare {
  margin: 30rpx;
  border-radius: 10rpx;
  border: 2px dashed #FFFFFF;
  padding: 5rpx 15rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #FFFFFF;
  line-height: 44rpx;
  width: -webkit-fit-content;
  width: fit-content;
}
.head .headoption {
  display: flex;
  gap: 57rpx;
  margin: 35rpx 30rpx;
}
.head .headoption .headoptioni {
  display: flex;
  gap: 13rpx;
  align-items: center;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #FFFFFF;
  line-height: 44rpx;
}
.head .headoption .headoptioni image {
  width: 30rpx;
  height: 30rpx;
}
.content {
  background: #FFFFFF;
  border-radius: 39rpx;
  padding-bottom: 200rpx;
}
.content .contentinfo {
  margin: 20rpx 30rpx;
}
.content .contentinfo .contentinfohr {
  height: 2rpx;
  background: #DBE1E6;
  opacity: 0.5;
  border-radius: 1rpx;
  margin: 30rpx 0;
}
.content .contentinfo .contentinfomain {
  display: flex;
  gap: 24rpx;
  align-items: center;
}
.content .contentinfo .contentinfomain .contentinfomainleft {
  width: 226rpx;
  height: 160rpx;
  position: relative;
  overflow: hidden;
}
.content .contentinfo .contentinfomain .contentinfomainleft image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.content .contentinfo .contentinfomain .contentinfomainleft view {
  position: absolute;
  bottom: 12rpx;
  right: 14rpx;
  border-radius: 4rpx;
  background-color: rgba(0, 0, 0, 0.4);
  padding: 0 6rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 24rpx;
  color: #FFFFFF;
  line-height: 44rpx;
}
.content .contentinfo .contentinfomain .contentinfomainright {
  flex: 1;
  width: 0;
}
.content .contentinfo .contentinfomain .contentinfomainright .contentinfomainrighttitle {
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 28rpx;
  color: #333333;
  line-height: 44rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.content .contentinfo .contentinfomain .contentinfomainright .contentinfomainrightsubtitle {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 20rpx;
  color: #92969E;
  line-height: 44rpx;
  margin-bottom: 15rpx;
}
.content .contentinfo .contentinfomain .contentinfomainright .contentinfomainrightbottom {
  display: flex;
  justify-content: space-between;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
  color: #92969E;
  line-height: 44rpx;
  margin-top: 12rpx;
}
.content .contentinfo .contentinfomain .contentinfomainright .progress {
  width: 28rpx;
  height: 28rpx;
  background: #0D7CFF;
  border-radius: 50%;
}
.content .contenttask {
  padding: 20rpx 30rpx;
  border-bottom: 10rpx solid #f0f0f0;
}
.content .contenttask .contenttaskcreate {
  height: 96rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 2px solid #F1F1F1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
}
.content .contenttask .contenttaskcreate .contenttaskcreateleft {
  margin-left: -11rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 28rpx;
  color: #232323;
  line-height: 44rpx;
}
.content .contenttask .contenttaskcreate .contenttaskcreateleft image {
  width: 32rpx;
  height: 32rpx;
}
.content .contenttask .contenttasknone {
  height: 592rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #92969E;
  line-height: 56rpx;
}
.content .contenttask .contenttasknone image {
  width: 228rpx;
  height: 228rpx;
}
.content .contenttrend {
  padding: 30rpx;
}
.content .contenttrend .contenttrendnone {
  height: 592rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #92969E;
  line-height: 56rpx;
}
.content .contenttrend .contenttrendnone image {
  width: 228rpx;
  height: 228rpx;
}
.content .contenttrend .contenttrendcheck {
  display: flex;
  align-items: center;
  gap: 21rpx;
}
.content .contenttrend .contenttrendcheck .contenttrendcheckright {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #555555;
  line-height: 28rpx;
}
.content .contenttrend .contenttrendcheck .contenttrendcheckright image {
  width: 24rpx;
  height: 24rpx;
}
.content .contenttrend .contenttrendcheck .contenttrendcheckinput {
  flex: 1;
  width: 0;
  height: 72rpx;
  background: #F4F6F8;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
}
.content .contenttrend .contenttrendcheck .contenttrendcheckinput image {
  width: 33rpx;
  height: 36rpx;
  margin-left: 22rpx;
}
.content .contenttrend .contenttrendcheck .contenttrendcheckinput .icon {
  width: 2rpx;
  height: 24rpx;
  background: #92969E;
  border-radius: 1rpx;
  margin-left: 33rpx;
  margin-right: 27rpx;
}
.bottom {
  position: fixed;
  bottom: 0;
  width: 100%;
  background: #FFFFFF;
  box-shadow: 0rpx 0rpx 5rpx 0rpx rgba(169, 169, 169, 0.35);
}
.bottom .bottombutton {
  margin: 20rpx 30rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0D7CFF;
  border-radius: 16rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 32rpx;
  color: #FFFFFF;
}