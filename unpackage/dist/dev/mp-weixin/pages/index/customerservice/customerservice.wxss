.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}
.headtitle {
  position: fixed;
  top: 100rpx;
  left: 30rpx;
  height: 64rpx;
  display: flex;
  gap: 34rpx;
  align-items: center;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 36rpx;
  color: #FFFFFF;
  line-height: 28rpx;
}
.bottom {
  display: flex;
  gap: 30rpx;
  padding: 16rpx 30rpx;
  align-items: center;
}
.bottom image {
  width: 46rpx;
  height: 46rpx;
}
.bottom .bottombutton {
  width: 100rpx;
  height: 66rpx;
  background: #0D7CFF;
  border-radius: 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 42rpx;
}
.bottom input {
  flex: 1;
  background: #F5F6F8;
  border-radius: 10rpx;
  height: 66rpx;
}
.chat {
  background-color: #f0f0f0;
  margin-top: -80rpx;
  border-radius: 28rpx 28rpx 0rpx 0rpx;
  height: 0;
  flex: 1;
}
.chat .chati {
  padding: 36rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}
.chat .chati .chatmy {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}
.chat .chati .chatmy image {
  width: 84rpx;
  height: 84rpx;
  background: #9DD4CD;
  border-radius: 42rpx;
  border: 2px solid #FFFFFF;
}
.chat .chati .chatmy view {
  max-width: 439rpx;
  background-color: #0D7CFF;
  position: relative;
  border-radius: 10rpx;
  padding: 24rpx 30rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 42rpx;
}
.chat .chati .chatmy view .chatbox {
  background-color: #0D7CFF;
  position: absolute;
  top: 12rpx;
  right: -60rpx;
  -webkit-clip-path: polygon(0% 0%, 15rpx 15rpx, 0% 30rpx);
          clip-path: polygon(0% 0%, 15rpx 15rpx, 0% 30rpx);
}
.chat .chati .chatmy .chatimg {
  width: 260rpx;
  height: 180rpx;
  background: #C1E6FF;
  border-radius: 20rpx;
}
.chat .chati .chatother {
  display: flex;
  gap: 24rpx;
}
.chat .chati .chatother image {
  width: 84rpx;
  height: 84rpx;
  background: #9DD4CD;
  border-radius: 42rpx;
  border: 2px solid #FFFFFF;
}
.chat .chati .chatother .chatotherinfo .chatothername {
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 26rpx;
  color: #888888;
  line-height: 42rpx;
  margin-bottom: 18rpx;
}
.chat .chati .chatother .chatotherinfo view {
  max-width: 439rpx;
  background-color: #fff;
  position: relative;
  border-radius: 10rpx;
  padding: 24rpx 30rpx;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 28rpx;
  color: #090707;
  line-height: 42rpx;
}
.chat .chati .chatother .chatotherinfo view .chatbox {
  background-color: #fff;
  position: absolute;
  top: 12rpx;
  left: -15rpx;
  -webkit-clip-path: polygon(0 15rpx, 15rpx 0, 15rpx 30rpx);
          clip-path: polygon(0 15rpx, 15rpx 0, 15rpx 30rpx);
}
.chat .chati .chatother .chatotherinfo .chatimg {
  width: 260rpx;
  height: 180rpx;
  background: #C1E6FF;
  border-radius: 10rpx;
}
.chat .chati .chattag {
  margin: 0 auto;
  background: #DADADA;
  border-radius: 10rpx;
  font-family: PingFang SC;
  font-weight: bold;
  font-size: 26rpx;
  color: #FFFFFF;
  line-height: 32rpx;
  padding: 10rpx 18rpx;
}